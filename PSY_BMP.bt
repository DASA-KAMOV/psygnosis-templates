//
// Each Value is 2 bytes (16bits) ?
//

typedef struct {
    int16 magic;                // 01 00
    int16 width;
    int16 height;
    int16 numColours;
    int16 unknown2;
    int16 unknown3;
 } BMPData <style=sSection1>;
