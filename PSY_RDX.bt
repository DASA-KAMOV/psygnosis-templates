//------------------------------------------------

typedef struct {
    char magic [8];
    int32 numFiles; // Matches number of files listed in RES.RDI
    } RDXHeader <style=sSection1>;

typedef struct {
    int16 unknown1;
    int16 Unknown2;
    int16 Unknown3;
    int16 Unknown4;
    } FileData <style=sSection2>;
    
RDXHeader RDX_Header;

FileData File[RDX_Header.numFiles];